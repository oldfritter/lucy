oss:
  Asset: http://asset.abc.cn
  Endpoint: https://oss-cn-heyuan.aliyuncs.com
  AccessKeyId: abcdefg
  AccessKeySecret: 123456789
  AssetsBucket: asset

rabbitmq:
  host: localhost
  port: 5672
  username: guest
  password: guest
  vhost: /

wechat:
  app_id: wx1234567890abcdef
  mch_id: 1234567890
  api_v3_key: your_32_char_api_v3_key_here_plz
  serial_no: ABCDEF1234567890ABCDEF1234567890ABCDEF12
  private_key_path: config/wechat/apiclient_key.pem
  notify_url: https://your-domain.com/api/v1/wechat/notify
  refund_notify_url: https://your-domain.com/api/v1/wechat/refund_notify

alipay:
  app_id: 2021000000000000
  private_key_path: config/alipay/private_key.pem
  alipay_public_key_path: config/alipay/alipay_public_key.pem
  notify_url: https://your-domain.com/api/v1/alipay/notify
  return_url: https://your-domain.com/payment/return
  gateway: https://openapi.alipay.com/gateway.do
  sign_type: RSA2

worker:
  - name: CaptchaImage
    defaultPrefix: true
    queue: lucy:captcha:image
    log: log/CaptchaImage.log
    threads: 2
